# Exemplo de variáveis de ambiente para a plataforma Nutriens
# Copie este arquivo para .env no ambiente local ou configure na Vercel (Project Settings -> Environment Variables)

VITE_NEON_AUTH_URL=https://<seu-endpoint>.neonauth.<regiao>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://<seu-endpoint>.apirest.<regiao>.aws.neon.tech/neondb/rest/v1
